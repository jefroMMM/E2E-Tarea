{
  "name": "cafeteria-e2e", "version": "1.0.0", "private": true,
  "description": "Pedidos de cafetería con Express, SQLite y Cypress",
  "engines": { "node": ">=22.13 <23" },
  "scripts": {
    "start": "node server.js",
    "start:test": "node --env-file=.env.test server.js",
    "seed": "node scripts/seed.js",
    "seed:test": "node --env-file=.env.test scripts/seed.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "node scripts/run-tests.js",
    "test:reverse": "node scripts/run-tests.js --reverse",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "express": "5.1.0" },
  "devDependencies": { "cypress": "16.0.0", "typescript": "5.9.3", "@types/node": "22.18.10" }
}
