{
  "name": "cafeteria-e2e", "version": "1.0.0", "private": true,
  "description": "Pedidos de cafetería con Express, SQLite y Cypress",
  "engines": { "node": ">=22.13 <23" },
  "scripts": {
    "start": "node server.js",
    "start:test": "node --env-file=.env.test server.js",
    "seed": "node scripts/seed.js",
    "seed:test": "node --env-file=.env.test scripts/seed.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test start:test http://127.0.0.1:3000/api/health cy:run",
    "test:reverse": "start-server-and-test start:test http://127.0.0.1:3000/api/health \"node scripts/reverse-tests.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "express": "5.1.0" },
  "devDependencies": { "cypress": "16.0.0", "typescript": "5.9.3", "start-server-and-test": "2.1.3", "@types/node": "22.18.10" }
}
